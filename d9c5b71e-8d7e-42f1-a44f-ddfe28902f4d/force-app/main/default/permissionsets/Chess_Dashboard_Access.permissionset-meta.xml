<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
            <fullName>Chess_Dashboard_Access</fullName>
            <label>Chess Dashboard Access</label>
            <description>Grants read access to Account object and access to Chess Dashboard Lightning Web Component, Apex controller, custom tab, and custom application</description><!-- Tab Settings - Make custom tabs visible -->
            
            <tabSettings>
                <tab>Chess_Dashboard</tab>
                <visibility>Visible</visibility>
            </tabSettings>
            
            
            <!-- Application Visibility - Make custom applications available -->
            
            <applicationVisibilities>
                <application>Chess_App</application>
                <visible>true</visible>
            </applicationVisibilities>
            
            
            <!-- Apex Class Access - Grant access to Apex classes -->
            
            <classAccesses>
                <apexClass>ChessDashboardController</apexClass>
                <enabled>true</enabled>
            </classAccesses>
            
            
            <!-- Run Flow Permission - Required when project has screen flows -->
            
            
            <hasActivationRequired>false</hasActivationRequired>
        </PermissionSet>