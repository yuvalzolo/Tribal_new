<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
            <fullName>ECP_EnterpriseCRMAccess</fullName>
            <label>Enterprise CRM Access</label>
            <description>Grants full access to Enterprise CRM Platform custom fields, Apex classes, tabs, and application</description><!-- Field Permissions - Make custom fields visible and editable based on isEditable (required fields are excluded) -->
            
            <fieldPermissions>
                
                <editable>true</editable>
                
                <field>Account.ECP_Account_Tier__c</field>
                <readable>true</readable>
            </fieldPermissions>
            
            <fieldPermissions>
                
                <editable>true</editable>
                
                <field>Account.ECP_Annual_Contract_Value__c</field>
                <readable>true</readable>
            </fieldPermissions>
            
            <fieldPermissions>
                
                <editable>true</editable>
                
                <field>Account.ECP_Last_Engagement_Date__c</field>
                <readable>true</readable>
            </fieldPermissions>
            
            <fieldPermissions>
                
                <editable>true</editable>
                
                <field>Account.ECP_Primary_Industry__c</field>
                <readable>true</readable>
            </fieldPermissions>
            
            <fieldPermissions>
                
                <editable>true</editable>
                
                <field>Account.ECP_Account_Manager__c</field>
                <readable>true</readable>
            </fieldPermissions>
            
            <fieldPermissions>
                
                <editable>true</editable>
                
                <field>Contact.ECP_Contact_Role__c</field>
                <readable>true</readable>
            </fieldPermissions>
            
            <fieldPermissions>
                
                <editable>true</editable>
                
                <field>Contact.ECP_Engagement_Level__c</field>
                <readable>true</readable>
            </fieldPermissions>
            
            <fieldPermissions>
                
                <editable>true</editable>
                
                <field>Contact.ECP_Preferred_Contact_Method__c</field>
                <readable>true</readable>
            </fieldPermissions>
            
            <fieldPermissions>
                
                <editable>true</editable>
                
                <field>Contact.ECP_Last_Contact_Date__c</field>
                <readable>true</readable>
            </fieldPermissions>
            
            <fieldPermissions>
                
                <editable>true</editable>
                
                <field>Contact.ECP_LinkedIn_Profile__c</field>
                <readable>true</readable>
            </fieldPermissions>
            
            <fieldPermissions>
                
                <editable>true</editable>
                
                <field>Opportunity.ECP_Deal_Priority__c</field>
                <readable>true</readable>
            </fieldPermissions>
            
            <fieldPermissions>
                
                <editable>true</editable>
                
                <field>Opportunity.ECP_Next_Step_Date__c</field>
                <readable>true</readable>
            </fieldPermissions>
            
            <fieldPermissions>
                
                <editable>true</editable>
                
                <field>Opportunity.ECP_Win_Probability__c</field>
                <readable>true</readable>
            </fieldPermissions>
            
            <fieldPermissions>
                
                <editable>true</editable>
                
                <field>Opportunity.ECP_Decision_Criteria__c</field>
                <readable>true</readable>
            </fieldPermissions>
            
            <fieldPermissions>
                
                <editable>true</editable>
                
                <field>Opportunity.ECP_Executive_Sponsor__c</field>
                <readable>true</readable>
            </fieldPermissions>
            
            
            <!-- Tab Settings - Make custom tabs visible -->
            
            <tabSettings>
                <tab>AcctOpptyDashboard</tab>
                <visibility>Visible</visibility>
            </tabSettings>
            
            <tabSettings>
                <tab>ContactMgmtHub</tab>
                <visibility>Visible</visibility>
            </tabSettings>
            
            
            <!-- Application Visibility - Make custom applications available -->
            
            <applicationVisibilities>
                <application>EnterpriseCRMPlatform</application>
                <visible>true</visible>
            </applicationVisibilities>
            
            
            <!-- Apex Class Access - Grant access to Apex classes -->
            
            <classAccesses>
                <apexClass>ECP_AccountOpptyController</apexClass>
                <enabled>true</enabled>
            </classAccesses>
            
            <classAccesses>
                <apexClass>ECP_ContactMgmtController</apexClass>
                <enabled>true</enabled>
            </classAccesses>
            
            
            <!-- Run Flow Permission - Required when project has screen flows -->
            
            
            <hasActivationRequired>false</hasActivationRequired>
        </PermissionSet>